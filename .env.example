# Copy to .env ABOVE the web root and fill in. The real .env is never committed.
# On Namecheap cPanel keep it in the account home folder, outside public_html and public/.

# local, staging or production. The app refuses to start on anything else.
APP_ENV=local
APP_DEBUG=0
APP_URL=http://localhost:8080

# LOCAL ONLY. Lets you look at signed-in pages (customer, staff, owner) with a mock person while sign-in is not built.
# The app refuses to start with this set anywhere but local with MOCK_DATA=1.
PREVIEW_LOGIN=

# Set to 1 only in local and staging. Production refuses to start with this on (CTL-ENV-001).
MOCK_DATA=1

# Application database user: SELECT, INSERT, UPDATE, DELETE only. No schema changes.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=belis_bell
DB_USER=
DB_PASS=

# Secret used to store emailed sign-in codes as a keyed hash. At least 32 random characters, different per environment.
# Generate one with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"  Never commit it. Changing it invalidates unused codes.
AUTH_PEPPER=

# Master key for the settings saved in the owner Settings page (Paystack keys, SMTP, etc.): 64 hex characters, different per
# environment. Generate: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"  Never commit it. Losing it makes saved settings unreadable
# (you would re-enter them); change it only with php bin/rotate-settings-key.php. Required in production.
SETTINGS_KEY=

# How emails are sent. Only "log" exists: it writes to storage/logs/mail.log for local development. Production refuses it,
# so real sending (SMTP) must be built and approved before launch.
MAIL_DRIVER=log

# WhatsApp click-to-chat number in international format, digits only (DEC-008). Leave empty to hide the button.
WHATSAPP_NUMBER=

# Paystack and email values can be saved in the owner Settings page instead; a value saved there wins over the one below.
# Paystack. Test keys (sk_test_...) in local and staging. Live keys only after GATE-006 and owner approval.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYMENTS_ADAPTER=paystack
# Local development only: PAYMENTS_ADAPTER=mock uses a pretend payment page (refused in production and outside APP_ENV=local).
# Required in production when a live key is set: the reference of the recorded owner approval.
RELEASE_APPROVAL_REF=
